{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Environment setup
    "types": ["node"],
    "rootDir": ".",

    // Check only; the build config owns emit
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
