{
  "name": "@josesuite/node",
  "version": "1.0.0",
  "description": "Secure, standards-compliant JOSE library for Node.js covering JWS, JWE, JWT, JWK, JWKS, and JWA.",
  "homepage": "https://docs.josesuite.com",
  "bugs": {
    "url": "https://github.com/josesuite/node/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Madan Sapkota",
    "email": "developermadan+jose@gmail.com",
    "url": "https://madansapkota.com",
    "role": "Maintainer"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josesuite/node.git"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "build": "tsc",
    "test": "bun test",
    "test:coverage": "bun test --coverage-reporter=lcov"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2 <2.0.0",
    "node": "^20.20.2"
  }
}
