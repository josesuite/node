{
  "name": "@josesuite/node",
  "version": "1.0.0",
  "description": "Secure, standards-compliant JOSE library for Node.js covering JWS, JWE, JWT, JWK, JWKS, and JWA.",
  "homepage": "https://docs.josesuite.com",
  "bugs": {
    "url": "https://github.com/josesuite/node/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Madan Sapkota",
    "email": "developermadan+jose@gmail.com",
    "url": "https://madansapkota.com",
    "role": "Maintainer"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josesuite/node.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "build": "tsc",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=lcov.info"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.20.0"
  }
}
