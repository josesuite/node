{
  "name": "@josesuite/node",
  "version": "1.0.0",
  "description": "Security-focused, standards-compliant JOSE for Node.js with JWS, JWE, JWT, JWK/JWKS, JWA, strict validation, and explicit algorithm policies.",
  "keywords": [
    "aes-gcm",
    "authentication",
    "cryptography",
    "ecdh-es",
    "ecdsa",
    "ed25519",
    "hmac",
    "jose",
    "json-web-algorithms",
    "json-web-encryption",
    "json-web-key",
    "json-web-signature",
    "json-web-token",
    "jwa",
    "jwe",
    "jwk",
    "jwks",
    "jws",
    "jwt",
    "nodejs",
    "oauth2",
    "openid-connect",
    "rfc7515",
    "rfc7516",
    "rfc7517",
    "rfc7518",
    "rfc7519",
    "rsa",
    "security",
    "typescript",
    "webcrypto"
  ],
  "homepage": "https://docs.josesuite.com",
  "bugs": {
    "url": "https://github.com/josesuite/node/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Madan Sapkota",
    "email": "developermadan+jose@gmail.com",
    "url": "https://madansapkota.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josesuite/node.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "build": "tsc",
    "test": "node --test",
    "test_legacy": "bunx tsx --test $(find tests -type f -name '*.test.ts')",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-reporter=lcov --test-reporter-destination=lcov.info"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
